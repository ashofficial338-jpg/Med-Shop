# Public URL of the separately deployed backend, with "/api" appended.
# Vite bakes this in at build time, so set it in the host's environment
# (Render: the static site's Environment tab) before building.
#
# Leave unset for local dev - Vite's dev server proxies /api and /uploads to
# http://localhost:5000 (see vite.config.js).
# VITE_API_URL=https://med-backend-k198.onrender.com/api
VITE_API_URL=
