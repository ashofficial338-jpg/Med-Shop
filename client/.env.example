# Leave unset for local dev - Vite's dev server proxies /api and /uploads to
# http://localhost:5000 (see vite.config.js), so relative "/api" already works.
#
# Set this only when the frontend is built/served separately from the
# backend (e.g. two Render services), pointing at the backend's public URL
# with "/api" appended:
# VITE_API_URL=https://med-shop-api.onrender.com/api
VITE_API_URL=https://med-backend-6-188x.onrender.com/api
