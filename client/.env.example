# Copy to .env and fill in. All client configuration lives in that one file.

# Production backend: public URL of the deployed backend + "/api".
# Vite bakes this in at build time, so on Vercel set it in Project Settings >
# Environment Variables before building.
VITE_API_URL=https://med-shop-3.onrender.com/api

# Local dev (npm run dev): where Vite proxies /api and /uploads.
# Use http://localhost:5000 for the backend in ../server, or the Render origin.
# If unset, dev falls back to VITE_API_URL above.
DEV_API_PROXY=https://med-shop-3.onrender.com
